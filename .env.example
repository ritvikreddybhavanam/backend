# ==============================================================================
# Cinephile Spring Boot Backend - Environment Variables Template
# Copy or set these environment variables in your deployment environment (e.g. Render)
# ==============================================================================

# Server Port (Render provides $PORT dynamically; maps to PORT / SERVER_PORT)
PORT=8080
SERVER_PORT=8080

# Active Spring Profile (set to 'prod' in production)
SPRING_PROFILES_ACTIVE=dev

# JWT Signing Secret (Minimum 32 characters / 256 bits for HMAC-SHA256)
# Required in production. Application will fail startup if missing when SPRING_PROFILES_ACTIVE=prod or on Render.
JWT_SECRET=<your-high-entropy-jwt-secret-minimum-32-characters>

# Database Configuration (MySQL)
# Example for hosted MySQL (e.g. Aiven, TiDB Cloud, Railway, PlanetScale):
SPRING_DATASOURCE_URL=jdbc:mysql://<hosted-mysql-host>:3306/<database-name>?useSSL=true&requireSSL=true
SPRING_DATASOURCE_USERNAME=<database-username>
SPRING_DATASOURCE_PASSWORD=<database-password>

# The Movie Database (TMDB) API Configuration
# Get your v4 Read Access Token from: https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=<your-tmdb-v4-read-access-token>
TMDB_BASE_URL=https://api.themoviedb.org/3
